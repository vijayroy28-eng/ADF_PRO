						"activity": "Get File Names",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get File Names').output.childItems",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "SwitchFileNames",
							"type": "Switch",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"on": {
									"value": "@replace(item().name,'.' ,'' )",
									"type": "Expression"
								},
								"cases": [
									{
										"value": "datajson",
										"activities": [
											{
												"name": "WaitCSV",
												"type": "Wait",
												"dependsOn": [],
												"userProperties": [],
												"typeProperties": {
													"waitTimeInSeconds": 3
												}
											}
										]
									},
									{
										"value": "git_datacsv",
										"activities": [
											{
												"name": "WaitJson",
												"type": "Wait",
												"dependsOn": [],
												"userProperties": [],
												"typeProperties": {
													"waitTimeInSeconds": 6
												}
											}
										]
									}
								]
							}
						}
					]
				}
			}
		],
