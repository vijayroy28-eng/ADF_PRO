{
	"name": "DeltaFlow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Dynamic_DataSet",
						"type": "DatasetReference"
					},
					"name": "DeltaSource"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "Azure_LS_Data_Lake",
						"type": "LinkedServiceReference"
					},
					"name": "sink"
				}
			],
			"transformations": [
				{
					"name": "UpperCaseState"
				},
				{
					"name": "selectCols"
				},
				{
					"name": "alterRow"
				}
			],
			"scriptLines": [
				"source(output(",
				"          location_id as short,",
				"          city as string,",
				"          state as string,",
				"          country as string,",
				"          latitude as double,",
				"          longitude as double,",
				"          last_updated_timestamp as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DeltaSource",
				"DeltaSource derive(state = upper(state),",
				"          longitude = round(longitude, 2, 2),",
				"          current_date = currentDate('PST')) ~> UpperCaseState",
				"UpperCaseState select(mapColumn(",
				"          location_id,",
				"          city,",
				"          state,",
				"          country,",
				"          last_updated_timestamp,",
				"          current_date",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectCols",
				"selectCols alterRow(upsertIf(1==1)) ~> alterRow",
				"alterRow sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'sink',",
				"     folderPath: 'Delta_Sink',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: false,",
				"     updateable: false,",
				"     upsertable: true,",
				"     keys:['location_id'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink"
			]
		}
	}
}